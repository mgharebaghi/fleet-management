  @@schema("inventory")
}

model PartVehicleCompatibility {
  PartId         Int          @default(autoincrement())
  VehicleModelId Int
  Description    String?      @db.NVarChar(500)
  Part           Part         @relation(fields: [PartId], references: [PartId], onUpdate: NoAction, map: "FK_PartVehicleCompatibility_Part")
  VehicleModel   VehicleModel @relation(fields: [VehicleModelId], references: [ModelId], onUpdate: NoAction, map: "FK_PartVehicleCompatibility_VehicleModel")

  @@id([PartId, VehicleModelId], map: "PK_PartVehicleCompatibility")
  @@schema("inventory")
}

model StockTransaction {
  StockTransactionId BigInt    @id(map: "PK_StockTransaction") @default(autoincrement())
  WarehouseId        Int
  PartId             Int
  TransactionDate    DateTime  @default(dbgenerated("sysdatetime()"), map: "DF_StockTransaction_TransactionDate")
  TransactionType    String    @db.NVarChar(50)
  Quantity           Decimal   @db.Decimal(18, 2)
  UnitPrice          Decimal?  @db.Decimal(18, 2)
  Description        String?   @db.NVarChar(500)
  Part               Part      @relation(fields: [PartId], references: [PartId], onUpdate: NoAction, map: "FK_StockTransaction_Part")
  Warehouse          Warehouse @relation(fields: [WarehouseId], references: [WarehouseId], onUpdate: NoAction, map: "FK_StockTransaction_Warehouse")

  @@schema("inventory")
}

model Unit {
  UnitId   Int     @id(map: "PK_Unit") @default(autoincrement())
  UnitName String  @db.NVarChar(50)
  Symbol   String? @db.NVarChar(20)
  Part     Part[]

  @@schema("inventory")
}

model Warehouse {
  WarehouseId      Int                @id(map: "PK_Warehouse") @default(autoincrement())
  WarehouseCode    String             @db.NVarChar(50)
  WarehouseName    String             @db.NVarChar(150)
  Location         String?            @db.NVarChar(500)
  IsActive         Boolean            @default(true, map: "DF_Warehouse_IsActive")
  StockTransaction StockTransaction[]

  @@schema("inventory")
}
