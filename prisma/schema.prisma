generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
  schemas  = ["common", "driver", "fleet", "person", "trip"]
}

model Accident {
  AccidentId              BigInt                   @id(map: "PK_Accident") @default(autoincrement())
  VehicleAssignmentId     Int?
  AccidentDateTime        DateTime
  Location                String?                  @db.NVarChar(300)
  Description             String?
  DamageAmount            Decimal?                 @db.Decimal(18, 2)
  DriverFaultPercent      Decimal?                 @db.Decimal(5, 2)
  PoliceReportNo          String?                  @db.NVarChar(100)
  HasInjury               Boolean                  @default(false, map: "DF_Accident_HasInjury")
  TripRequestId           Int?
  TripRequest             TripRequest?             @relation(fields: [TripRequestId], references: [TripRequestId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Accident_TripRequest")
  VehicleDriverAssignment VehicleDriverAssignment? @relation(fields: [VehicleAssignmentId], references: [AssignmentId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Accident_VehicleDriverAssignment")

  @@schema("driver")
}

model Driver {
  DriverId                Int                       @id(map: "PK_Driver") @default(autoincrement())
  PersonId                Int                       @unique(map: "UQ_Driver_PersonId")
  People                  People                    @relation(fields: [PersonId], references: [PersonId], onUpdate: NoAction, map: "FK_Driver_person")
  DriverLicense           DriverLicense[]
  VehicleDriverAssignment VehicleDriverAssignment[]

  @@schema("driver")
}

model DriverLicense {
  DriverLicenseId Int       @id(map: "PK_DriverLicense") @default(autoincrement())
  DriverId        Int
  LicenseType     String    @db.NVarChar(100)
  LicenseNo       String    @db.NVarChar(50)
  IssueDate       DateTime? @db.Date
  ExpireDate      DateTime? @db.Date
  IsActive        Boolean   @default(true, map: "DF_DriverLicense_IsActive")
  Driver          Driver    @relation(fields: [DriverId], references: [DriverId], onUpdate: NoAction, map: "FK_DriverLicense_Driver")

  @@schema("driver")
}

model FuelType {
  FuelTypeId   Int            @id(map: "PK_FuelType") @default(autoincrement())
  FuelTypeName String         @db.NVarChar(50)
  IsActive     Boolean        @default(true, map: "DF_FuelType_IsActive")
  VehicleModel VehicleModel[]

  @@schema("fleet")
}

model People {
  PersonnelNo    String?   @db.NVarChar(50)
  FirstName      String    @db.NVarChar(100)
  LastName       String    @db.NVarChar(100)
  NationalCode   String?   @db.NVarChar(20)
  CardNo         String?   @db.NVarChar(8)
  Mobile         String?   @db.NVarChar(20)
  EmploymentDate DateTime? @db.Date
  IsActive       Boolean   @default(true, map: "DF_person_IsActive")
  CreatedAt      DateTime  @default(dbgenerated("sysdatetime()"), map: "DF_person_CreatedAt")
  PersonId       Int       @id(map: "PK_person") @default(autoincrement())
  Driver         Driver?
  Trip           Trip[]

  @@schema("person")
}

model Vehicle {
  VehicleId               Int                       @id(map: "PK_Vehicle") @default(autoincrement())
  VehicleCode             String                    @db.NVarChar(50)
  PlateNoLeftSide         String                    @db.NVarChar(2)
  PlateNoCenterChar       String?                   @db.NVarChar(3)
  PlateNoRightSide        String?                   @db.NVarChar(3)
  PlateNoIranNo           String?                   @db.NVarChar(2)
  InternationalPlateNo    String?                   @db.NVarChar(10)
  VIN                     String?                   @db.NVarChar(50)
  EngineNo                String?                   @db.NVarChar(50)
  ChassisNo               String?                   @db.NVarChar(50)
  ModelId                 Int
  ModelYear               Int?                      @db.SmallInt
  VehicleStatusId         Int
  PurchaseDate            DateTime?                 @db.Date
  PurchasePrice           Decimal?                  @db.Decimal(18, 2)
  CurrentOdometer         Decimal?                  @db.Decimal(18, 2)
  CurrentEngineHour       Decimal?                  @db.Decimal(18, 2)
  IsActive                Boolean                   @default(true, map: "DF_Vehicle_IsActive")
  CreatedAt               DateTime                  @default(dbgenerated("sysdatetime()"), map: "DF_Vehicle_CreatedAt")
  VehicleModel            VehicleModel              @relation(fields: [ModelId], references: [ModelId], onUpdate: NoAction, map: "FK_Vehicle_VehicleModel")
  VehicleStatus           VehicleStatus             @relation(fields: [VehicleStatusId], references: [VehicleStatusId], onUpdate: NoAction, map: "FK_Vehicle_VehicleStatus")
  VehicleDriverAssignment VehicleDriverAssignment[]
  VehicleInsurance        VehicleInsurance[]
  VehicleMeterReading     VehicleMeterReading[]

  @@schema("fleet")
}

model VehicleBrand {
  BrandId      Int            @id(map: "PK_VehicleBrand") @default(autoincrement())
  BrandName    String         @db.NVarChar(100)
  IsActive     Boolean        @default(true, map: "DF_VehicleBrand_IsActive")
  VehicleModel VehicleModel[]

  @@schema("fleet")
}

model VehicleDriverAssignment {
  AssignmentId     Int                @id(map: "PK_VehicleDriverAssignment") @default(autoincrement())
  DriverId         Int
  VehicleId        Int
  FromDateTime     DateTime
  ToDateTime       DateTime?
  StartOdometer    Decimal?           @db.Decimal(18, 2)
  EndOdometer      Decimal?           @db.Decimal(18, 2)
  Description      String?            @db.NVarChar(500)
  Accident         Accident[]
  TripExecution    TripExecution[]
  Driver           Driver             @relation(fields: [DriverId], references: [DriverId], onUpdate: NoAction, map: "FK_VehicleDriverAssignment_Driver")
  Vehicle          Vehicle            @relation(fields: [VehicleId], references: [VehicleId], onUpdate: NoAction, map: "FK_VehicleDriverAssignment_Vehicle")
  VehicleViolation VehicleViolation[]

  @@schema("driver")
}

model VehicleInsurance {
  VehicleInsuranceId BigInt   @id(map: "PK_VehicleInsurance") @default(autoincrement())
  VehicleId          Int
  InsuranceType      String   @db.NVarChar(100)
  InsuranceCompany   String?  @db.NVarChar(150)
  PolicyNo           String?  @db.NVarChar(100)
  StartDate          DateTime @db.Date
  ExpireDate         DateTime @db.Date
  PremiumAmount      Decimal? @db.Decimal(18, 2)
  CoverageAmount     Decimal? @db.Decimal(18, 2)
  IsActive           Boolean  @default(true, map: "DF_VehicleInsurance_IsActive")
  Vehicle            Vehicle  @relation(fields: [VehicleId], references: [VehicleId], onUpdate: NoAction, map: "FK_VehicleInsurance_Vehicle")

  @@schema("fleet")
}

model VehicleMeterReading {
  MeterReadingId Int      @id(map: "PK_VehicleMeterReading") @default(autoincrement())
  VehicleId      Int
  ReadingDate    DateTime
  Odometer       Decimal? @db.Decimal(18, 2)
  EngineHour     Decimal? @db.Decimal(18, 2)
  Description    String?  @db.NVarChar(500)
  Vehicle        Vehicle  @relation(fields: [VehicleId], references: [VehicleId], onUpdate: NoAction, map: "FK_VehicleMeterReading_Vehicle")

  @@schema("fleet")
}

model VehicleModel {
  ModelId       Int          @id(map: "PK_VehicleModel") @default(autoincrement())
  BrandId       Int
  VehicleTypeId Int?
  ModelName     String       @db.NVarChar(100)
  FuelTypeId    Int?
  IsActive      Boolean      @default(true, map: "DF_VehicleModel_IsActive")
  Vehicle       Vehicle[]
  FuelType      FuelType?    @relation(fields: [FuelTypeId], references: [FuelTypeId], onDelete: NoAction, onUpdate: NoAction, map: "FK_VehicleModel_FuelType")
  VehicleBrand  VehicleBrand @relation(fields: [BrandId], references: [BrandId], onUpdate: NoAction, map: "FK_VehicleModel_VehicleBrand")
  VehicleType   VehicleType? @relation(fields: [VehicleTypeId], references: [VehicleTypeId], onDelete: NoAction, onUpdate: NoAction, map: "FK_VehicleModel_VehicleType")

  @@schema("fleet")
}

model VehicleStatus {
  VehicleStatusId Int       @id(map: "PK_VehicleStatus") @default(autoincrement())
  StatusName      String    @db.NVarChar(50)
  Vehicle         Vehicle[]

  @@schema("fleet")
}

model VehicleType {
  VehicleTypeId Int            @id(map: "PK_VehicleType") @default(autoincrement())
  TypeName      String         @db.NVarChar(100)
  IsActive      Boolean        @default(true, map: "DF_VehicleType_IsActive")
  VehicleModel  VehicleModel[]

  @@schema("fleet")
}

model VehicleViolation {
  ViolationId             BigInt                   @id(map: "PK_VehicleViolation") @default(autoincrement())
  VehicleAssignmentId     Int?
  ViolationDateTime       DateTime
  ViolationType           String                   @db.NVarChar(150)
  Location                String?                  @db.NVarChar(300)
  Amount                  Decimal                  @db.Decimal(18, 2)
  ReferenceNo             String?                  @db.NVarChar(100)
  Status                  String                   @default("N'Unpaid'", map: "DF_VehicleViolation_Status") @db.NVarChar(50)
  PaidDate                DateTime?                @db.Date
  Description             String?
  TripRequestId           Int?
  TripRequest             TripRequest?             @relation(fields: [TripRequestId], references: [TripRequestId], onDelete: NoAction, onUpdate: NoAction, map: "FK_VehicleViolation_TripRequest")
  VehicleDriverAssignment VehicleDriverAssignment? @relation(fields: [VehicleAssignmentId], references: [AssignmentId], onDelete: NoAction, onUpdate: NoAction, map: "FK_VehicleViolation_VehicleDriverAssignment")

  @@schema("driver")
}

model Location {
  LocationId                                Int          @id(map: "PK_Location") @default(autoincrement())
  LocationCode                              String?      @db.NVarChar(50)
  LocationName                              String       @db.NVarChar(200)
  LocationType                              String?      @db.NVarChar(100)
  Address                                   String?
  Latitude                                  Decimal?     @db.Decimal(9, 6)
  Longitude                                 Decimal?     @db.Decimal(9, 6)
  Description                               String?
  IsActive                                  Boolean?
  CreatedAt                                 DateTime?
  RoutePoint                                RoutePoint[]
  Trip_Trip_OriginLocationIdToLocation      Trip[]       @relation("Trip_OriginLocationIdToLocation")
  Trip_Trip_DestinationLocationIdToLocation Trip[]       @relation("Trip_DestinationLocationIdToLocation")

  @@schema("common")
}

model Route {
  RouteId                 Int            @id(map: "PK_Route") @default(autoincrement())
  TripId                  Int?
  TripExecutionId         Int?
  RouteName               String         @db.NVarChar(200)
  AlternativeNo           Int?
  DistanceKm              Decimal?       @db.Decimal(10, 2)
  EstimatedDurationMinute Int?
  IsSelected              Boolean        @default(false, map: "DF_Route_IsSelected")
  Description             String?
  CreatedAt               DateTime       @default(dbgenerated("sysdatetime()"), map: "DF_Route_CreatedAt")
  Trip                    Trip?          @relation(fields: [TripId], references: [TripId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Route_Trip")
  TripExecution           TripExecution? @relation(fields: [TripExecutionId], references: [TripExecutionId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Route_TripExecution")
  RoutePoint              RoutePoint[]

  @@schema("trip")
}

model RoutePoint {
  RoutePointId        Int      @id(map: "PK_RoutePoint") @default(autoincrement())
  RouteId             Int
  LocationId          Int
  TrafficZone         String?  @db.NVarChar(50)
  SequenceNo          Int?
  DistanceFromStartKm Decimal? @db.Decimal(10, 2)
  Description         String?
  CreatedAt           DateTime @default(dbgenerated("sysdatetime()"), map: "DF_RoutePoint_CreatedAt")
  Location            Location @relation(fields: [LocationId], references: [LocationId], onUpdate: NoAction, map: "FK_RoutePoint_Location")
  Route               Route    @relation(fields: [RouteId], references: [RouteId], onUpdate: NoAction, map: "FK_RoutePoint_Route")

  @@schema("trip")
}

model Trip {
  TripId                                        Int             @id(map: "PK_Trip") @default(autoincrement())
  TripRequestId                                 Int
  PassengerPersonId                             Int
  OriginLocationId                              Int
  DestinationLocationId                         Int
  RequestedPickupDateTime                       DateTime?
  PickupOrder                                   Int?
  DropoffOrder                                  Int?
  Status                                        String?         @db.NVarChar(50)
  Description                                   String?
  Route                                         Route[]
  Location_Trip_OriginLocationIdToLocation      Location        @relation("Trip_OriginLocationIdToLocation", fields: [OriginLocationId], references: [LocationId], onUpdate: NoAction, map: "FK_Trip_Location")
  Location_Trip_DestinationLocationIdToLocation Location        @relation("Trip_DestinationLocationIdToLocation", fields: [DestinationLocationId], references: [LocationId], onUpdate: NoAction, map: "FK_Trip_Location1")
  People                                        People          @relation(fields: [PassengerPersonId], references: [PersonId], onUpdate: NoAction, map: "FK_Trip_People")
  TripRequest                                   TripRequest     @relation(fields: [TripRequestId], references: [TripRequestId], onUpdate: NoAction, map: "FK_Trip_TripRequest")
  TripExecution                                 TripExecution[]

  @@schema("trip")
}

model TripExecution {
  TripExecutionId           Int                     @id(map: "PK_TripExecution") @default(autoincrement())
  TripId                    Int
  VehicleDriverAssignmentId Int
  ActualPickupDateTime      DateTime?
  ActualDropoffDateTime     DateTime?
  StartOdometer             Decimal?                @db.Decimal(18, 2)
  EndOdometer               Decimal?                @db.Decimal(18, 2)
  Status                    String                  @db.NVarChar(50)
  PassengerRating           Int?
  PassengerComment          String?
  SurveyDateTime            DateTime?
  Description               String?
  CreatedAt                 DateTime?
  Route                     Route[]
  Trip                      Trip                    @relation(fields: [TripId], references: [TripId], onUpdate: NoAction, map: "FK_TripExecution_Trip")
  VehicleDriverAssignment   VehicleDriverAssignment @relation(fields: [VehicleDriverAssignmentId], references: [AssignmentId], onUpdate: NoAction, map: "FK_TripExecution_VehicleDriverAssignment")

  @@schema("trip")
}

model TripRequest {
  TripRequestId           Int                @id(map: "PK_TripRequest") @default(autoincrement())
  RequestNo               String             @db.NVarChar(50)
  TripRequestTypeId       Int
  RequestDateTime         DateTime
  RequestedTravelDateTime DateTime
  Purpose                 String?            @db.NVarChar(500)
  Status                  String             @db.NVarChar(50)
  Description             String?
  CreatedAt               DateTime
  Accident                Accident[]
  Trip                    Trip[]
  TripRequestType         TripRequestType    @relation(fields: [TripRequestTypeId], references: [TripRequestTypeId], onUpdate: NoAction, map: "FK_TripRequest_TripRequestType")
  VehicleViolation        VehicleViolation[]

  @@schema("trip")
}

model TripRequestType {
  TripRequestTypeId Int           @id(map: "PK_TripRequestType")
  TypeCode          String        @unique(map: "UQ_TripRequestType_TypeCode") @db.VarChar(50)
  TypeName          String        @db.NVarChar(150)
  Description       String?       @db.NVarChar(500)
  TripRequest       TripRequest[]

  @@schema("trip")
}

model VehicleTrip {
  TripId             BigInt    @id(map: "PK_VehicleTrip") @default(autoincrement())
  VehicleId          Int
  DriverId           Int?
  RouteId            Int?
  RouteAlternativeId Int?
  DepartureDateTime  DateTime
  ReturnDateTime     DateTime?
  StartOdometer      Decimal?  @db.Decimal(18, 2)
  EndOdometer        Decimal?  @db.Decimal(18, 2)
  Purpose            String?   @db.NVarChar(500)
  Description        String?

  @@schema("trip")
}
