# Copy this file to .env (development), .env.test.local (integration tests)
# and .env.e2e.local (E2E tests) and fill in real, non-shared credentials.
# Never commit the copies — they are ignored by .gitignore.

# ---------------------------------------------------------------------------
# Development database (.env)
# Prisma CLI (introspection, validate) reads DATABASE_URL.
# Prisma Client at runtime reads the DATABASE_* variables below instead.
# ---------------------------------------------------------------------------
DATABASE_URL="sqlserver://localhost:1433;database=FleetManagementDB_05;schema=dbo;user=YOUR_USER;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true;"
DATABASE_SERVER="localhost"
DATABASE_PORT="1433"
DATABASE_NAME="FleetManagementDB_05"
DATABASE_USER="YOUR_DEV_USER"
DATABASE_PASSWORD="YOUR_DEV_PASSWORD"
DATABASE_ENCRYPT="true"
DATABASE_TRUST_SERVER_CERTIFICATE="true"

# ---------------------------------------------------------------------------
# Integration test database (.env.test.local)
# Must be a database isolated from development; its name must contain
# "IntegrationTest" or the integration test suite refuses to run.
# ---------------------------------------------------------------------------
TEST_DATABASE_SERVER="localhost"
TEST_DATABASE_PORT="1433"
TEST_DATABASE_NAME="FleetManagementDB_Integrationtest"
TEST_DATABASE_USER="YOUR_TEST_USER"
TEST_DATABASE_PASSWORD="YOUR_TEST_PASSWORD"
TEST_DATABASE_ENCRYPT="true"
TEST_DATABASE_TRUST_SERVER_CERTIFICATE="true"

# ---------------------------------------------------------------------------
# E2E test database (.env.e2e.local)
# Must be named FleetManagementDB_E2ETest and different from both the
# development and integration databases, or Playwright refuses to start.
# ---------------------------------------------------------------------------
E2E_DATABASE_SERVER="localhost"
E2E_DATABASE_PORT="1433"
E2E_DATABASE_NAME="FleetManagementDB_E2ETest"
E2E_DATABASE_USER="YOUR_E2E_USER"
E2E_DATABASE_PASSWORD="YOUR_E2E_PASSWORD"
E2E_DATABASE_ENCRYPT="true"
E2E_DATABASE_TRUST_SERVER_CERTIFICATE="true"
